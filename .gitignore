# ============================================================
#  MIPI-HDMI 工程忽略规则（安路 TangDynasty TD）
#  说明：只忽略"可由工具重新生成"的产物与本地环境文件，
#        源码（.v/.sv/.py/.md）、约束（.adc/.sdc）、IP 配置
#        （Design.xml 等）、工程文件（.al）都必须入库。
# ============================================================

# ===== 安路 TD 编译/下载产物 =====
*.bit
*.mcs
*.bin
*.svf
*.rpt
*.bit.gz
*.mcs.gz
*.bid
*.qor
*.status
*.area
*.prj
*.cfg

# ===== 日志 / 报告 / 临时文件 =====
*.log
*.logw
*.timing
*.timingsummary
*.jou
*.str
*.bak
*.tmp
*.swp
*.old
*.htm
*.html
.lock.f
~$*

# ===== IP 工具自动备份目录（可重建）=====
.IpToolIpDataBackupDir_*
.ipToolIpDataBackupDir_*

# ===== 工程编译运行目录 =====
**/td_project/*_Runs/
**/td_project/log/
**/td_project/al_ip/
**/Runs/
**/syn_run/
**/phy_run/
**/_tmp/
**/tmp/

# ===== 编辑器 / IDE 本地配置 =====
.vscode/
.idea/
*.code-workspace
*.user
*.suo

# ===== Python 脚本（gamma LUT 生成器）缓存 =====
__pycache__/
*.pyc
*.pyo

# ===== 位级仿真过程产物（iverilog/vvp 可重新生成）=====
*.out
*.vcd
*_result.txt
*.vvp
# 位级对拍 dump（verify_*.py 可重新生成；pattern*.hex 为激励，需入库）
user_source/hdl_source/common_base/sim/*_out*.txt

# ===== 位级对拍参考模型（可从 git 历史重新生成，避免仓库膨胀 ~294KB）=====
#   sim_hdl/logo_rom_ref_case.v = anlogic_logo_rom.v 改造成 ERAM 版之前的 case 版
#   重新生成：
#     git show <改造前commit>:user_source/hdl_source/anlogic_logo_rom.v \
#       | sed 's/^module anlogic_logo_rom (/module logo_rom_ref_case (/' \
#       > user_source/hdl_source/sim_hdl/logo_rom_ref_case.v
user_source/hdl_source/sim_hdl/logo_rom_ref_case.v

# ===== 过程产物：数据手册文本抽取（可重新生成，且有版权风险）=====
user_source/hdl_source/gamma_fix/refs/

# ===== 系统 / 编辑器 =====
Thumbs.db
Desktop.ini
.DS_Store
